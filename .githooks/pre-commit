#!/bin/sh
# Redraws the previews of any game whose source changed, and stages them, so pictures never lag the game.
# Enable once per clone: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
for candidate in .venv/Scripts/python .venv/bin/python python3 python; do
  if command -v "$candidate" >/dev/null 2>&1 || [ -x "$candidate" ]; then PY="$candidate"; break; fi
done
[ -n "$PY" ] || { echo "pre-commit: no Python found; run tools/make_media.py --stale yourself" >&2; exit 1; }
"$PY" tools/make_media.py --stale || exit 1
git add docs/previews
